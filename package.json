{
  "name": "nodefund-bff",
  "version": "2.0.0",
  "description": "BFF Service & DynamoDB Gateway for nodefund - Distributed Node Architecture",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local DYNAMODB_ENDPOINT=http://localhost:8100 AUTH_DISABLED=true node --test tests/bff/*.test.js",
    "test:py": "python3 -m unittest discover tests",
    "cluster": "./run.sh",
    "setup:local": "node scripts/setup-local-db.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "bff",
    "nodefund",
    "distributed-node",
    "finance",
    "api-gateway",
    "dynamodb",
    "cognito"
  ],
  "author": "nodefund",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-jwt-verify": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
