# ============================================================
# nodefund — Variáveis de Ambiente
# ============================================================

# --- Servidor BFF ---
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# --- Worker Analítico Python ---
ANALYTICS_NODE_URL=http://127.0.0.1:8001
ANALYTICS_NODE_TIMEOUT_MS=30000

# --- AWS DynamoDB ---
DYNAMODB_TABLE_NAME=nodefund
DYNAMODB_ENDPOINT=http://localhost:8100
AWS_REGION=us-east-1

# Para desenvolvimento local (DynamoDB Local):
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- AWS Cognito ---
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Autenticação ---
# Desabilitar validação JWT em desenvolvimento local:
AUTH_DISABLED=true

# --- Cluster ---
CLUSTER_ID=nodefund-cluster-alpha
NODE_ID=bff-gateway-01
